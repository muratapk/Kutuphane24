@model IEnumerable<Kutuphane.Models.Uyeler>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Soyad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefon)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Adres)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KayitTarihi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Oduncler)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Ad)
            </td>
            <td>
                @Html.DisplayFor(model => item.Soyad)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Telefon)
            </td>
            <td>
                @Html.DisplayFor(model => item.Adres)
            </td>
            <td>
                @Html.DisplayFor(model => item.KayitTarihi)
            </td>
            <td>
                @Html.DisplayFor(model => item.Oduncler)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.UyeId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.UyeId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.UyeId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
